# Copy to .env and edit. Every value here has a working default in
# app/config.py, so the service starts with no .env at all.

# --- database --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./custodian.db
DEBUG=false

# --- ACME ------------------------------------------------------------------
# pebble             local test CA, no real certificates, no rate limits
# letsencrypt_staging  real protocol, untrusted certs, generous limits
# letsencrypt        real certificates, strict rate limits -- read them first
CA_PROVIDER=pebble

# Overrides CA_PROVIDER when set. Use it for any other RFC 8555 CA.
# ACME_DIRECTORY_URL=

ACME_CONTACT_EMAIL=
ACCOUNT_KEY_PATH=./data/account.key
CERT_DIR=./data/certs
WEBROOT_PATH=./data/webroot

# ec (P-256, the default) or rsa
DOMAIN_KEY_TYPE=ec

# Skips TLS verification when talking to the ACME server. Required for
# Pebble, which serves its API under its own test root.
# It is IGNORED when pointed at Let's Encrypt -- see Settings.verify_acme_tls.
ACME_INSECURE=true

# --- lifecycle -------------------------------------------------------------
RENEWAL_THRESHOLD_DAYS=30
SCAN_TIMEOUT_SECONDS=8
SCAN_CONCURRENCY=20

# --- AI --------------------------------------------------------------------
# Default is true. The service is fully functional without a model: renewal
# planning falls back to the deterministic ranking in app/ai/planner.py.
LLM_DISABLED=true

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MAX_PLANNED=25
